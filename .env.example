# Copy this file to .env and fill in real values. Never commit .env.

# Home Assistant instance, reachable from wherever this container runs
# (e.g. http://192.168.1.50:8123 for the Unraid box's LAN IP).
HA_URL=http://192.168.1.50:8123

# Home Assistant long-lived access token.
# Generate: HA -> your profile (bottom left) -> Security tab ->
# "Long-lived access tokens" -> Create Token.
HA_TOKEN=

# Random secret this bridge requires on every request, independent of HA_TOKEN.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# This is the value you enter when adding the custom connector in Claude.
BRIDGE_TOKEN=

PORT=8000
